NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_WORKER_ACCESS_TOKEN=

SMS_PROVIDER=NEXTSMS
NEXTSMS_BASE_URL=https://messaging-service.co.tz
NEXTSMS_SINGLE_SMS_PATH=/api/sms/v1/text/single
NEXTSMS_AUTHORIZATION="Basic replace-with-provider-credential"
NEXTSMS_DEFAULT_SENDER_ID=MICHANGO
NEXTSMS_ALLOWED_SENDER_IDS=SHEREHE,MICHANGO,KIKAO

WEBBULKSMS_URL=https://webbulksms.co.tz/api/v1/send-sms
WEBBULKSMS_USERNAME=your-webbulksms-username
WEBBULKSMS_PASSWORD=your-webbulksms-password
WEBBULKSMS_SENDER_ID=AHADI

WORKER_POLL_INTERVAL_MS=30000
WORKER_BATCH_SIZE=10

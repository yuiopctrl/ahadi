{
  "name": "@ahadi/worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "diagnose": "node --import tsx src/index.ts --diagnose",
    "once": "node --import tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@ahadi/sms": "workspace:*",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2"
  }
}

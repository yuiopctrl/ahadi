{
  "name": "@ahadi/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "sms:test": "node --import tsx src/scripts/sms-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@ahadi/config": "workspace:*",
    "@ahadi/database": "workspace:*",
    "@ahadi/types": "workspace:*",
    "@ahadi/validation": "workspace:*",
    "@supabase/supabase-js": "^2.112.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ahadi/ui/*": ["packages/ui/src/*"],
      "@ahadi/types/*": ["packages/types/src/*"],
      "@ahadi/validation/*": ["packages/validation/src/*"],
      "@ahadi/config/*": ["packages/config/src/*"],
      "@ahadi/database/*": ["packages/database/src/*"]
    }
  }
}
